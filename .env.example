# Azure DevOps organization (the part after dev.azure.com/)
AZDO_ORG=your-org
# Project and team shown on the board
AZDO_PROJECT=Your Project
AZDO_TEAM=Your Project Team
# Your Azure DevOps e-mail ("Only my issues", "Assign to me", default assignee)
AZDO_ME=you@example.com
# Personal Access Token with Work Items (Read & Write)
PERSONAL_ACCESS_TOKEN=
# Default UI language when the user hasn't picked one: en | pt
APP_LANG=en
# Process rules file (defaults to process.config.json, then process.config.example.json)
# PROCESS_CONFIG=process.config.json
PORT=3001
