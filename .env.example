# Azure DevOps organization (the part after dev.azure.com/)
AZDO_ORG=your-org
# Project and team shown on the board
AZDO_PROJECT=Your Project
AZDO_TEAM=Your Project Team
# Your Azure DevOps e-mail ("Only my issues", "Assign to me", default assignee)
AZDO_ME=you@example.com
# Personal Access Token with Work Items (Read & Write)
PERSONAL_ACCESS_TOKEN=
# Default UI language when the user hasn't picked one: en | pt
APP_LANG=en
# Process rules file (defaults to process.config.json, then process.config.example.json)
# PROCESS_CONFIG=process.config.json
PORT=3001

# Multi-user & credential settings:
# By default, every user is prompted in the UI for their own Azure DevOps PAT (encrypted in an HttpOnly cookie),
# and their identity (name & e-mail) is resolved automatically from Azure DevOps.
# Set GOOGLE_AUTH_ENABLED=true (plus GOOGLE_CLIENT_ID) to ALSO require Google Sign-In before entering the PAT.
GOOGLE_AUTH_ENABLED=false
# GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com
# ALLOWED_EMAIL_DOMAIN=example.com
# ALLOWED_EMAILS=alice@example.com,bob@example.com
# SESSION_SECRET=replace-with-at-least-32-random-hex-bytes
# MAX_MCP_CLIENTS=12
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# Set PAT_AUTH_REQUIRED=false only if you want single-user local mode using PERSONAL_ACCESS_TOKEN above without UI prompt.

# Demo mode: `npm run demo` (or AZDO_DEMO=1) uses fictional in-memory data, no Azure DevOps or PAT.
