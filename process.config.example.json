{
  "$comment": "Example for the default Azure DevOps Scrum process. Copy to process.config.json and adapt to your process. See README > Process rules.",
  "planning": null,
  "links": {
    "prPrefix": ""
  },
  "blocked": {
    "field": "Microsoft.VSTS.CMMI.Blocked",
    "value": "Yes",
    "fieldTypes": [
      "Task"
    ],
    "tag": "blocked"
  },
  "validation": {
    "states": [],
    "tag": "validation",
    "tagState": {
      "Task": "In Progress",
      "Product Backlog Item": "Committed",
      "Bug": "Committed"
    }
  },
  "fields": [
    {
      "key": "effort",
      "ref": "Microsoft.VSTS.Scheduling.Effort",
      "label": {
        "en": "Effort",
        "pt": "Effort"
      },
      "types": [
        "Product Backlog Item",
        "Bug",
        "Feature"
      ],
      "input": "select",
      "numeric": true,
      "options": [
        "1",
        "2",
        "3",
        "5",
        "8",
        "13"
      ]
    },
    {
      "key": "storyPoints",
      "ref": "Microsoft.VSTS.Scheduling.StoryPoints",
      "label": {
        "en": "Story Points",
        "pt": "Story Points"
      },
      "types": [
        "Product Backlog Item"
      ],
      "input": "number"
    },
    {
      "key": "completedWork",
      "ref": "Microsoft.VSTS.Scheduling.CompletedWork",
      "label": {
        "en": "Completed Work",
        "pt": "Completed Work"
      },
      "types": [
        "Product Backlog Item",
        "Task",
        "Feature"
      ],
      "input": "number",
      "suffix": "h"
    },
    {
      "key": "remainingWork",
      "ref": "Microsoft.VSTS.Scheduling.RemainingWork",
      "label": {
        "en": "Remaining Work",
        "pt": "Remaining Work"
      },
      "types": [
        "Task",
        "Bug"
      ],
      "input": "number",
      "suffix": "h"
    },
    {
      "key": "activity",
      "ref": "Microsoft.VSTS.Common.Activity",
      "label": {
        "en": "Activity",
        "pt": "Activity"
      },
      "types": [
        "Task",
        "Bug"
      ],
      "input": "select",
      "options": [
        "Development",
        "Design",
        "Documentation",
        "Requirements",
        "Testing",
        "Deployment"
      ]
    },
    {
      "key": "releaseNotes",
      "ref": "Custom.ReleaseNotes",
      "label": {
        "en": "Release notes",
        "pt": "Notas de release"
      },
      "types": [
        "Product Backlog Item"
      ],
      "input": "rich",
      "hint": {
        "en": "Example of a custom rich-text field. Remove it if your process doesn't have it.",
        "pt": "Exemplo de campo de texto rico customizado. Remova se o seu processo não tiver."
      }
    }
  ],
  "create": {
    "Product Backlog Item": {
      "required": [],
      "optional": [
        "effort"
      ]
    },
    "Task": {
      "required": [],
      "optional": [
        "activity",
        "remainingWork"
      ]
    },
    "Bug": {
      "required": [],
      "optional": [
        "effort",
        "activity"
      ]
    },
    "Feature": {
      "required": [],
      "optional": [
        "effort"
      ]
    }
  },
  "typeRules": {
    "Product Backlog Item": {
      "descriptionRequired": false,
      "parentType": "Feature",
      "parentRequired": false
    },
    "Bug": {
      "descriptionRequired": false,
      "parentType": "Feature",
      "parentRequired": false
    },
    "Task": {
      "descriptionRequired": false,
      "parentType": "Product Backlog Item",
      "parentRequired": false,
      "inheritFromParent": true
    },
    "Feature": {
      "descriptionRequired": false,
      "parentType": "Epic",
      "parentRequired": false
    }
  },
  "transitions": {
    "Task": {
      "Done": [
        {
          "key": "completedWorkAdd",
          "required": true,
          "hint": {
            "en": "Hours spent, added to the current Completed Work.",
            "pt": "Horas gastas, somadas ao Completed Work atual."
          }
        }
      ]
    }
  },
  "detailFields": {
    "Product Backlog Item": [
      "effort",
      "storyPoints",
      "completedWork"
    ],
    "Task": [
      "activity",
      "completedWork",
      "remainingWork"
    ],
    "Bug": [
      "effort",
      "activity",
      "remainingWork"
    ],
    "Feature": [
      "effort",
      "completedWork"
    ]
  }
}